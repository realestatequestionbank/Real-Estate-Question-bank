rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read/write their own document AND all subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Subcollection: questionProgress
      match /questionProgress/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Subcollection: stateProgress
      match /stateProgress/{state} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Progress collection (for sessions)
    match /progress/{docId} {
      allow read, write: if request.auth != null;
    }
    
    // Sessions
    match /sessions/{docId} {
      allow read, write: if request.auth != null;
    }
    
    // Feedback
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
    }
    
    // Purchases
    match /purchases/{purchaseId} {
      allow read: if request.auth != null;
    }
    
    // Free Downloads Lead Collection
    match /free_downloads/{docId} {
      allow create: if true;
    }
  }
}
