# Firebase Admin Configuration (Backend only)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-service-account-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_CDL_PRICE_ID=price_1TiPirAB2lLx6zTOAf2ljhdp

# Note: 
# - For production, use sk_live_ prefix for Stripe secret key
# - Firebase private key should be wrapped in double quotes and contain actual newlines (\n)
# - Webhook secret is obtained from Stripe dashboard after creating webhook endpoint
# - Firebase client config is in lib/firebase/config.ts (no env vars needed)

# Resend Configuration
RESEND_API_KEY=your_resend_api_key_here